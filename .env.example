# =============================================================================
# TSecBench 托管模式容器 — 环境变量模板
#
# 用法（二选一）：
#   1) 平台「开始评测 → 托管模式 → 第3步 运行时环境变量」表单逐条填入，
#      或用「从 .env 导入」上传本文件（先复制为 .env 并填值）
#   2) 本地自测：cp .env.example .env && 填值
#      docker run --rm --env-file .env tsecbench-agent:latest
#
# 原则：密钥只经环境变量进入容器，绝不写进镜像或仓库（评测须知第 3 条）。
#       本文件不含任何真实密钥，可以提交。
# =============================================================================

# -----------------------------------------------------------------------------
# 平台自动注入 — 不要自己填，填了也会被平台的值覆盖
# -----------------------------------------------------------------------------
# BENCHMARK_TOKEN=<平台创建任务后自动注入>
# BENCHMARK_BASE_URL=<平台自动注入，通常即 https://tsecbench.zc.tencent.com>

# -----------------------------------------------------------------------------
# 模型 API（必填三项）
# -----------------------------------------------------------------------------

# 模型 API base URL 按此值原样传递给 Claude Code；入口不识别类型、不改写、不校验。
LLM_API_BASE_URL=http://api.deepseek.com.tsecbench.gw/anthropic

# 模型 API KEY（只走进程环境，不会写进容器文件系统）
LLM_API_KEY=

# 模型名。注意：主模型与后台小模型槽位都会指向它——
# 离线沙箱里若后台调用指向不存在的模型，会以难排查的方式失败
LLM_DEFAULT_MODEL=deepseek-flash

# -----------------------------------------------------------------------------
# 模型接入（可选）
# -----------------------------------------------------------------------------

# 平台接受的协议：anthropic-messages（默认）| openai-completions | openai-responses
# Claude Code 说的是 Anthropic Messages 线协议；选后两者前确认网关真的做了转换
LLM_API_TYPE=anthropic-messages

# 鉴权头：bearer = Authorization: Bearer <key>（网关常用，默认）
#          api-key = X-Api-Key: <key>（仅此模式可用 TSEC_CC_BARE=1）
#TSEC_AUTH_MODE=bearer


# =1 进入 Claude Code bare 模式（更快更简），代价：
#   * 只认 ANTHROPIC_API_KEY（bearer 模式会被入口自动降级并告警）
#   * --plugin-dir 挂的技能/深层放行 mod 不会加载
#TSEC_CC_BARE=0

# -----------------------------------------------------------------------------
# 提示词（归你写；容器启动时注入，改完重建镜像即生效）
# -----------------------------------------------------------------------------
#
#   docker/claude/RUNBOOK.md        核心提示词：claude --bg 启动时给的那一条
#   docker/claude/LOOP_PROMPT.md    loop 提示词：agent 想收工时，Stop hook 作为
#                                   「继续干」的理由还给它的那一条；每次 Stop 都
#                                   重新读，SessionStart 时也作为附加上下文注入一次
#   docker/claude/SYSTEM_APPEND.md  追加进系统提示词（--append-system-prompt）
#
# 两个 md 开头的 HTML 注释是写给你看的，不会进入模型。

# -----------------------------------------------------------------------------
# 运行编排（可选）
# -----------------------------------------------------------------------------

# 并发 worker 数：1 = 单 agent（claude --bg 常驻会话，由 entrypoint 监管）；
# >1 = 舰队（coordinator 按 free_slots 分发，平台硬上限 3 道活跃题）
#TSEC_WORKERS=1
# TSEC_FLEET_WORKERS 是 TSEC_WORKERS 的兼容别名（显式 TSEC_WORKERS 优先）
#TSEC_FLEET_WORKERS=1

# 监管轮询间隔秒数：多久检查一次「会话还在不在」。会话在就什么都不做。
#TSEC_AGENT_CHECK_SECONDS=60

# 存活判定用的进程匹配串（pgrep -f）。只有在容器里 claude 的进程名与预期不符时才改。
#TSEC_AGENT_PROC_PATTERN=claude

# Stop hook 的逃生阀（秒），默认 0 = 关闭：也就是 agent 永远停不下来（这是想要的）。
# 设成正数 = 「距上次鞭策不足这么多秒就放它过」。注意 --bg 模式下放它过 ≠ 进程结束，
# 而是会话干坐着没人叫醒，通常比不停鞭策更糟。
#TSEC_NUDGE_MIN_SECONDS=0

# 舰队：coordinator 轮询间隔秒数。没有黑名单 —— 没打完的题会重新进池接着打
#TSEC_FLEET_POLL_SECONDS=5

# 舰队 worker（一次性 claude -p）的输出流：stream-json（默认，需 --verbose）/ json / text。
# 单 agent 模式（TSEC_WORKERS=1）走 claude --bg 常驻会话，不经过这个开关。
#TSEC_CC_OUTPUT=stream-json

# =0 关闭保活循环（不建议：任务结束检测与孤儿容器救援都在里面）
#TSEC_KEEPALIVE=1

# 连续崩溃多少次后转入长暂停（退避指数增长，封顶 120s）。
# 注意：容器永不停止 —— 平台只给一次机会，退出的容器回不来，
# 所以这里到顶也只是停久一点再继续，不是放弃。
#TSEC_MAX_ATTEMPTS=5
#TSEC_BACKOFF_SECONDS=10

# 空转间隔秒数。平台说没活干（任务结束/全部解完）或自设截止到点时，按这个周期
# 重新问平台；容器不退出，任务被重新打开能自动接上，不需要重启容器。
#TSEC_IDLE_SECONDS=300

# 启动自检硬失败时的停放间隔秒数（停放 ≠ 退出，容器仍在，原因写在 state/PARKED）
#TSEC_PARK_SECONDS=300

# 保活循环间隔秒数（心跳 + 平台探活 + 任务结束即停 agent + 孤儿容器救援）
#TSEC_KEEPALIVE_INTERVAL=300

# MCP initialize 握手之前对平台 challenges API 发起的只读预热请求次数（默认 3；范围 0–20）
#TSEC_PREINIT_API_CALLS=3

# 硬截止分钟数（到点不再开新会话，转空转；0 = 不限，由平台时限决定）
#TSEC_DEADLINE_MINUTES=0

# -----------------------------------------------------------------------------
# 本地自测专用（托管模式不要设置）
# -----------------------------------------------------------------------------

# =0 允许在没有 BENCHMARK_TOKEN 的情况下启动（MCP 工具会返回配置指引而非崩溃）
#TSEC_REQUIRE_BENCH_ENV=1

# =1 只做配置渲染 + MCP 连通性预检，不启动 agent（不需要模型、不需要 token）
#TSEC_PREFLIGHT_ONLY=1

# 指向仓库自带的离线 mock 平台做端到端联调
# 本地跑: python mcp/tests/mock_tsec_api.py --port 18099 --token test-token --vpn-port 18097
#BENCHMARK_BASE_URL=http://host.docker.internal:18099
#BENCHMARK_TOKEN=test-token

# =============================================================================
# 以下变量已固化在镜像 ENV / settings.json 中，一般无需覆盖（列出备查）
# =============================================================================
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1   # 离线必开（存在即生效，勿设 0 期望关闭）
# DISABLE_TELEMETRY=1 / DISABLE_ERROR_REPORTING=1 / DISABLE_AUTOUPDATER=1 ...
# IS_SANDBOX=1                                  # root 下 --dangerously-skip-permissions 需要
# MCP_TIMEOUT=120000 / MCP_TOOL_TIMEOUT=600000  # MCP 启动/单次调用超时（ms）
# BASH_DEFAULT_TIMEOUT_MS=600000 / BASH_MAX_TIMEOUT_MS=1800000
# TSEC_STATE_DIR=/work/state                    # 持久笔记账本（note_save/note_list）
# TSEC_LOG_DIR=/work/logs                       # agent/fleet/heartbeat 日志
# TSEC_MCP_DIR=/opt/tsecbench
# TSEC_VPN_CHECK_URL=http://10.0.100.58         # VPN 预检地址（本地模式才需要）
